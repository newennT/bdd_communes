<form method="post" action="{{ path('app_admin_pays_delete', {'id': pay.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ pay.id) }}">
    <button class="btn btn-danger">{% trans %}Supprimer{% endtrans %}</button>
</form>